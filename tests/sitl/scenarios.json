        "SIM_GYR1_RND": 20,
        "SIM_GYR2_RND": 20,
        "SIM_GYR3_RND": 20,
        "INS_LOG_BAT_MASK": 1,
        "INS_LOG_BAT_OPT": 2,
        "INS_GYRO_FILTER": 100
