{
  "_doc": "SITL scenario definitions for ArduScope regression testing. Each scenario flies on the SITL binary and leaves a .BIN log with known conditions, then ArduScope should detect the expected issues. Steps are the step_ methods of Flight in generate_logs.py. Parameter names are checked against the firmware when the flight starts.",
  "scenarios": [
    {
      "name": "copter_normal",
      "vehicle": "ArduCopter",
      "description": "Clean hover + waypoint mission, no faults injected",
      "sitl_params": {},
      "expected": {
        "health_score_min": 70,
        "analyzers_good": [
          "vibration",
          "motor",
          "gps",
          "ekf",
          "battery"
        ],
        "analyzers_not_critical": [
          "attitude",
          "compass",
          "imu_consistency"
        ]
      },
      "steps": [
        {
          "takeoff": 15
        },
        {
          "mission": [
            [
              60,
              0,
              20
            ],
            [
              60,
              60,
              20
            ],
            [
              0,
              60,
              20
            ]
          ]
        },
        {
          "return": 240
        }
      ]
    },
    {
      "name": "copter_high_vibration",
      "vehicle": "ArduCopter",
      "description": "Motor 1 loses 30% of its thrust, with high vibration",
      "sitl_params": {
        "SIM_ACC1_RND": 30,
        "SIM_ACC2_RND": 30,
        "SIM_ACC3_RND": 30,
        "SIM_VIB_FREQ_X": 80,
        "SIM_VIB_FREQ_Y": 80,
        "SIM_VIB_FREQ_Z": 80,
        "SIM_ENGINE_FAIL": 1,
        "SIM_ENGINE_MUL": 0.7
      },
      "expected": {
        "analyzers_warning_or_critical": [
          "vibration"
        ],
        "cross_rules_should_fire": [
          "vibration_motor",
          "attitude_vibration_control",
          "vibration_imu_consistency"
        ]
      },
      "steps": [
        {
          "takeoff": 10
        },
        {
          "hold": 30
        },
        {
          "return": 240
        }
      ]
    },
